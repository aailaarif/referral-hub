<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <handlers>
      <add name="iisnode" path="run.cjs" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="NodeRoute" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="run.cjs" />
        </rule>
      </rules>
    </rewrite>

    <!-- Write logs to a writable folder -->
    <iisnode
      loggingEnabled="true"
      devErrorsEnabled="true"
      logDirectory="D:\home\LogFiles\iisnode"
    />

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>